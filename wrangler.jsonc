{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bracket",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  }
}
